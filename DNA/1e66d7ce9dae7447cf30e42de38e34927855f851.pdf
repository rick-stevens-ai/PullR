2F1535-7163.22507159.v1"}],"embargo":[],"isMetadataRecord":false,"exportPdfDownloadUrl":null,"citationPublicationDate":"2020\u002F01\u002F01","citationOnlineDate":"2023\u002F04\u002F03","publisher":"American Association for Cancer Research","resourceDoi":"10.1158\u002F1535-7163.MCT-19-0019","citationFormats":[{"__typename":"CitationFormat","name":"RefWorks","format":"refworks"},{"__typename":"CitationFormat","name":"BibTeX","format":"bibtex"},{"__typename":"CitationFormat","name":"Ref. manager","format":"reference_manager"},{"__typename":"CitationFormat","name":"Endnote","format":"endnote"},{"__typename":"CitationFormat","name":"DataCite","format":"datacite"},{"__typename":"CitationFormat","name":"NLM","format":"nlm"},{"__typename":"CitationFormat","name":"DC","format":"dc"}],"fundings({\"limit\":500,\"offset\":0})":{"__typename":"ArticleFundings","elements":[]},"files({\"cursor\":\"\",\"pageSize\":1})":{"__typename":"ArticlePublicFiles","elements":[{"__ref":"File:39967765"}]},"institution":{"__ref":"Institution:1012"},"linkbackCollection":{"__typename":"LinkbackCollection","resourcePublication":null,"resourceTitle":"The Novel ATR Inhibitor BAY 1895344 Is Efficacious as Monotherapy and Combined with DNA Damage–Inducing or Repair–Compromising Therapies in Preclinical Cancer Models","resourceDoi":"10.1158\u002F1535-7163.MCT-19-0019"},"branding":{"__typename":"ItemBranding","url":"https:\u002F\u002Faacr.figshare.com\u002Fmct","logo":"https:\u002F\u002Fs3-eu-west-1.amazonaws.com\u002F876az-branding-figshare\u002Faacr\u002Flogo.png","name":"Molecular Cancer Therapeutics"},"categories({\"limit\":500,\"offset\":0})":{"__typename":"ArticleCategories","elements":[{"__ref":"Category:37339"},{"__ref":"Category:37354"},{"__ref":"Category:37360"},{"__ref":"Category:37375"}]},"keywords({\"limit\":500,\"offset\":0})":{"__typename":"Keywords","elements":["Biochemistry","Small molecule\u002FDNA interactions","Preclinical Models","Xenograft models","Radiation Oncology","Combined modality therapies","Small Molecule Agents","DNA-reactive agents"]},"references({\"limit\":500,\"offset\":0})":{"__typename":"ArticleReferences","elements":[108588696]},"license":{"__typename":"License","url":"https:\u002F\u002Fcreativecommons.org\u002Flicenses\u002Fby\u002F4.0\u002F","logo":"","name":"CC BY"},"group":{"__typename":"Group","institution":{"__ref":"Institution:1012"},"timelineSettings":{"__typename":"TimelineSettings","enabled":[],"order":"asc"},"mintingInfo":[{"__typename":"MintingInfo","mintingTypeStr":"doi"}]},"timeline":{"__typename":"Timeline","onlinePublication":"2023-04-03T15:30:15+00:00","publisherPublication":"2020-01-01T00:00:00+00:00","publisherAcceptance":null,"revision":null,"submission":null,"posted":"2023-04-03T15:30:15+00:00"},"authors({\"limit\":500,\"offset\":0})":{"__typename":"PublicArticleAuthors","elements":[{"__ref":"Author:8769686"},{"__ref":"Author:2614108"},{"__ref":"Author:15073612"},{"__ref":"Author:15073615"},{"__ref":"Author:15073618"},{"__ref":"Author:2614111"},{"__ref":"Author:2982786"},{"__ref":"Author:15073621"},{"__ref":"Author:1399678"},{"__ref":"Author:15073624"},{"__ref":"Author:15011865"},{"__ref":"Author:11327011"},{"__ref":"Author:14928779"},{"__ref":"Author:87746"},{"__ref":"Author:14990931"},{"__ref":"Author:29304"},{"__ref":"Author:3022791"},{"__ref":"Author:5938586"},{"__ref":"Author:8769707"},{"__ref":"Author:167909"}]},"customFields({\"limit\":500,\"offset\":0})":{"__typename":"ArticleCustomFields","elements":[{"__typename":"CustomField","name":"ARTICLE ABSTRACT","value":"The DNA damage response (DDR) secures the integrity of the genome of eukaryotic cells. DDR deficiencies can promote tumorigenesis but concurrently may increase dependence on alternative repair pathways. The ataxia telangiectasia and Rad3-related (ATR) kinase plays a central role in the DDR by activating essential signaling pathways of DNA damage repair. Here, we studied the effect of the novel selective ATR kinase inhibitor BAY 1895344 on tumor cell growth and viability. Potent antiproliferative activity was demonstrated in a broad spectrum of human tumor cell lines. BAY 1895344 exhibited strong monotherapy efficacy in cancer xenograft models that carry DNA damage repair deficiencies. The combination of BAY 1895344 with DNA damage–inducing chemotherapy or external beam radiotherapy (EBRT) showed synergistic antitumor activity. Combination treatment with BAY 1895344 and DDR inhibitors achieved strong synergistic antiproliferative activity in vitro, and combined inhibition of ATR and PARP signaling using olaparib demonstrated synergistic antitumor activity in vivo. Furthermore, the combination of BAY 1895344 with the novel, nonsteroidal androgen receptor antagonist darolutamide resulted in significantly improved antitumor efficacy compared with respective single-agent treatments in hormone-dependent prostate cancer, and addition of EBRT resulted in even further enhanced antitumor efficacy. Thus, the ATR inhibitor BAY 1895344 may provide new therapeutic options for the treatment of cancers with certain DDR deficiencies in monotherapy and in combination with DNA damage–inducing or DNA repair–compromising cancer therapies by improving their efficacy.","fieldType":"textarea","settings":{"triggerType":"placeholder","validations":{"min_length":10,"max_length":10000},"placeholder":"ARTICLE ABSTRACT"}}]},"suplimentaryFields({\"limit\":500,\"offset\":0})":{"__typename":"ArticleSuplimentaryFields","elements":[]},"definedType":{"__ref":"ItemType:6"},"virusScanInfo":{"__typename":"VirusScanInfo","message":"File not scanned yet","virusFound":false},"versions({\"limit\":20,\"offset\":0,\"order\":\"desc\"})":{"__typename":"ArticleVersions","hasMore":false,"elements":[{"__typename":"ArticleVersion","version":1,"date":"2023-04-03T15:30:15+00:00","url":"\u002Farticles\u002Fjournal_contribution\u002FSupplementary_Tables_from_The_Novel_ATR_Inhibitor_BAY_1895344_Is_Efficacious_as_Monotherapy_and_Combined_with_DNA_Damage_Inducing_or_Repair_Compromising_Therapies_in_Preclinical_Cancer_Models\u002F22507159\u002F1"}]}},"ROOT_MUTATION":{"__typename":"Mutation"},"RelatedMaterial:108588696":{"__typename":"RelatedMaterial","id":108588696,"identifier":"10.1158\u002F1535-7163.MCT-19-0019","title":"The Novel ATR Inhibitor BAY 1895344 Is Efficacious as Monotherapy and Combined with DNA Damage–Inducing or Repair–Compromising Therapies in Preclinical Cancer Models","relation":"IsSupplementTo","identifierType":"DOI","isLinkout":true,"isUrl":true,"resolver":"https:\u002F\u002Fdoi.org\u002F"}}; }());</script><script nonce="Ds3vN+do01ipHPNQoTQbcQ==">;(function() { window.routerState = {"matchedPath":"\u002Farticles\u002F:itemType([a-zA-Z_-]+)?\u002F:url([a-zA-Z0-9_-]+)\u002F:id([0-9]+)"}; }());</script><script id="__LOADABLE_REQUIRED_CHUNKS__" type="application/json" nonce="Ds3vN+do01ipHPNQoTQbcQ==">[4121,7771]</script><script id="__LOADABLE_REQUIRED_CHUNKS___ext" type="application/json" nonce="Ds3vN+do01ipHPNQoTQbcQ==">{"namedChunks":["pages-item-public"]}</script><script async="" data-chunk="client" src="https://websitev3-p-eu.figstatic.com/assets-v3/2cd78a618a9efc7825198d9abd293784e81c2846/client.93dec771.js" nonce="Ds3vN+do01ipHPNQoTQbcQ=="></script><script async="" data-chunk="pages-item-public" src="https://websitev3-p-eu.figstatic.com/assets-v3/2cd78a618a9efc7825198d9abd293784e81c2846/static/js/vendor.8eb4e750.chunk.js" nonce="Ds3vN+do01ipHPNQoTQbcQ=="></script><script async="" data-chunk="pages-item-public" src="https://websitev3-p-eu.figstatic.com/assets-v3/2cd78a618a9efc7825198d9abd293784e81c2846/static/js/pages-item-public.3f50ced6.chunk.js" nonce="Ds3vN+do01ipHPNQoTQbcQ=="></script></body></html>