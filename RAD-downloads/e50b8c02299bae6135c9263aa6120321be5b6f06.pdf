                  <source srcset="https://iiif.elifesciences.org/lax/00047%2Felife-00047-fig1-v1.tif/full/1234,/0/default.webp 2x, https://iiif.elifesciences.org/lax/00047%2Felife-00047-fig1-v1.tif/full/617,/0/default.webp 1x"
                      type="image/webp"
