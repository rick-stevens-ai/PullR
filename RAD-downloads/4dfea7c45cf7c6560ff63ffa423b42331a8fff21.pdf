                    <h1 class="c-article-title" data-test="article-title" data-article-title="">Various modes of cell death induced by DNA damage</h1>
                    <ul class="c-article-author-list c-article-author-list--short" data-test="authors-list" data-component-authors-activator="authors-list"><li class="c-article-author-list__item"><a data-test="author-name" data-track="click" data-track-action="open author" data-track-label="link" data-track-index="1_2" data-track-context="researcher popup with no profile" href="#auth-O-Surova-Aff1" data-author-popup="auth-O-Surova-Aff1" data-author-search="Surova, O">O Surova</a><sup class="u-js-hide"><a href="#Aff1">1</a></sup> &amp; </li><li class="c-article-author-list__item"><a data-test="author-name" data-track="click" data-track-action="open author" data-track-label="link" data-track-index="2_2" data-track-context="researcher popup with no profile" href="#auth-B-Zhivotovsky-Aff1" data-author-popup="auth-B-Zhivotovsky-Aff1" data-author-search="Zhivotovsky, B" data-corresp-id="c1">B Zhivotovsky<svg width="16" height="16" focusable="false" role="img" aria-hidden="true" class="u-icon"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-eds-i-mail-medium"></use></svg></a><sup class="u-js-hide"><a href="#Aff1">1</a></sup> </li></ul>

                    

