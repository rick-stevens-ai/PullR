}},"key":"pZF3xDRgnX"}],"key":"oLZJKsAuTc"},{"type":"listItem","spread":true,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Prefect’s code runs similarly locally as well as on cloud services.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"cqDqsMXaLH"}],"key":"S5ytM4Sbvh"},{"type":"listItem","spread":true,"position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Prefect’s monitoring dashboard is open source, can be run locally, and is intuitive to use.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"F3SkTsol4h"}],"key":"Yms764XuMN"}],"key":"bN9eOUTgIx"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"We next describe in more detail the components of the workflow lifecycle.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"Jd6oC7P9Fs"}],"key":"aKR3S5zL2T"},{"type":"heading","depth":2,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Workflow Configuration","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"Szg0dcwqPd"}],"identifier":"workflow-configuration","label":"Workflow Configuration","html_id":"workflow-configuration","implicit":true,"enumerator":"4","key":"XNWrSV8eSi"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"The main goal of ","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"DUSrj5xJIc"},{"type":"inlineCode","value":"echodataflow","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"hOHPSkSc2V"},{"type":"text","value":" is to allow users to configure an echosounder data processing pipeline through editing configuration “recipe” templates. ","po