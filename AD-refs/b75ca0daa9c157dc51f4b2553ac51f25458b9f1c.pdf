s on the Dask cluster can also be monitored through the Dask dashboard.","position":{"start":{"line":301,"column":1},"end":{"line":301,"column":1}},"key":"u9jLmz2sBw"}],"key":"a9aMtj2dOn"}],"key":"JMVRZswEsr"}],"label":"fig:dask_progress","identifier":"fig:dask_progress","enumerator":"5","html_id":"fig-dask-progress","key":"PlMTrKPzYR"},{"type":"heading","depth":2,"position":{"start":{"line":306,"column":1},"end":{"line":306,"column":1}},"children":[{"type":"text","value":"Workflow Logging","position":{"start":{"line":306,"column":1},"end":{"line":306,"column":1}},"key":"VS3PvSt4TP"}],"label":"workflow-logging","identifier":"workflow-logging","html_id":"workflow-logging","enumerator":"7","key":"HHJOY5gaAc"},{"type":"paragraph","position":{"start":{"line":308,"column":1},"end":{"line":308,"column":1}},"children":[{"type":"text","value":"Processing large data archives requires a robust logging system to identify at which step and for which files the processing has failed. Locating the issues allows to set a path forward to resolve them: either through improving the robustness of the individual libraries performing the processing steps, or through identifying the artifacts of the data which are incompatible with the existing pipeline. To address this, we provide several approaches:","position":{"start":{"line":308,"column":1},"end":{"line":308,"column":1}},"key":"dktg7G3ZkO"}],"key":"RmynXKJJTV"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":310,"column":1},"end":{"line":313,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":310,"column":1},"end":{"line":310,"column":1}},"children":[{"type":"text","value":"Basic Logging with Dask Worker Streams: this approach configures Dask worker streams to handle ","position":{"start":{"line":310,"column":1},"end":{"line":310,"column":1}},"key":"QkUTBYNhU4"},{"type":"inlineCode","value":"echodataflow","position":{"start":{"line":310,"column":1},"end":{"line":310,"column":1}},"key":"PwezX81qtE"},{"type":"text","value":" logs, which is straightforward if exact log order is not crucial.","position":{"start":{"line":310,"column":1},"end":{"line":310,"column":1}},"key":"yeBsQTxODx"}],"key":"aRUzPfbJxl"},{"type":"listItem","spread":true,"position":{"start":{"line":311,"column":1},"end":{"line":311,"column":1}},"children":[{"type":"text","value":"Centralized Logging with Amazon CloudWatch ","position":{"start":{"line":311,"column":1},"end":{"line":311,"column":1}},"key":"vB5ztiBi3Y"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":311,"column":1},"end":{"line":311,"column":1}},"children":[{"type":"cite","identifier":"cloudwatch","label":"cloudwatch","kind":"parenthetical","position":{"start":{"line":311,"column":45},"end":{"line":311,"column":56}},"children":[{"type":"text","value":"Amazon Cloudwatch, n.d.","key":"UcBFnEjbVL"}],"enumerator":"33","key":"SiY8XaGVKw"}],"key":"iNMSf4T7oI"},{"type":"text","value":": this approach centralizes all logs for easy access and analysis. It can be useful when users are already utilizing ","key":"Om72hvmt2N"},{"type":"abbreviation","title":"Amazon Web Services","children":[{"type":"text","value":"AWS","key":"mb4ElSye1M"}],"key":"ZVyDAO1cpW"},{"type":"text","value":".","key":"T2yoKpFFoY"}],"key":"vnW9chAbAU"},{"type":"listItem","spread":true,"position":{"start":{"line":312,"column":1},"end":{"line":313,"column":1}},"children":[{"type":"text","value":"Advanced Logging with Apache Kafka ","position":{"start":{"line":312,"column":1},"end":{"line":312,"column":1}},"key":"CYISVeRtRT"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":312,"column":1},"end":{"line":312,"column":1}},"children":[{"type":"cite","identifier":"kafka","label":"kafka","kind":"parenthetical","position":{"start":{"line":312,"column":37},"end":{"line":312,"column":43}},"children":[{"type":"text","value":"Apache Kafka, n.d.","key":"P9pASck8dZ"}],"enumerator":"34","key":"ltwVIuznbi"}],"key":"HG2XWN3Vjm"},{"type":"text","value":" and Elastic Stack ","position":{"start":{"line":312,"column":1},"end":{"line":312,"column":1}},"key":"mkfwPLz8b7"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":312,"column":1},"end":{"line":312,"column":1}},"children":[{"type":"cite","identifier":"elastic_stack","label":"elastic_stack","kind":"parenthetical","position":{"start":{"line":312,"column":64},"end":{"line":312,"column":78}},"children":[{"type":"text","value":"Elastic Stack, n.d.","key":"lQ0xXcJbxj"}],"enumerator":"35","key":"AFK9gSN28z"}],"key":"WwaApFExg6"},{"type":"text","value":" (Elasticsearch, Kibana, Beats, Logstash): this approach leverages Kafka for log aggregation and Elastic Stack for log analysis and visualization, offering a robust solution for those who can maintain the infrastructure, for example data center managers.","position":{"start":{"line":312,"column":1},"end":{"line":312,"column":1}},"key":"xWac4X8nKD"}],"key":"T7iOxMTjfL"}],"key":"Dsdn7ttJY7"},{"type":"paragraph","position":{"start":{"line":314,"column":1},"end":{"line":314,"column":1}},"children":[{"type":"text","value":"By default if logging is not configured, all the worker messages are directed to the application console. The order of logs may not be preserved since logs are written once control returns from the Dask workers to the main application.","position":{"start":{"line":314,"column":1},"end":{"line":314,"column":1}},"key":"jDDtevWgRl"}],"key":"G4yrhdVgNy"},{"type":"heading","depth":2,"position":{"start":{"line":316,"column":1},"end":{"line":316,"column":1}},"children":[{"type":"text","value":"Workflow Deployment","position":{"start":{"line":316,"column":1},"end":{"line":316,"column":1}},"key":"NL3AhR6n6Y"}],"identifier":"workflow-deployment","label":"Workflow Deployment","html_id":"workflow-deployment","implicit":true,"enumerator":"8","key":"bRvZOVITJp"},{"type":"heading","depth":3,"position":{"start":{"line":318,"column":1},"end":{"line":318,"column":1}},"chil