th Python"},"first_page":349,"last_page":365,"numbering":{"heading_1":{"enabled":true},"heading_2":{"enabled":true},"heading_3":{"enabled":true},"heading_4":{"enabled":true},"heading_5":{"enabled":true},"heading_6":{"enabled":true}},"keywords":["prefect","workflow orchestration","dask","zarr","fisheries acoustics"],"affiliations":[{"id":"eScience Institute, University of Washington","name":"eScience Institute, University of Washington"},{"id":"Scientific Software Engineering Center, University of Washington","name":"Scientific Software Engineering Center, University of Washington"},{"id":"Applied Physics Laboratory, University of Washington","name":"Applied Physics Laboratory, University of Washington"},{"id":"GDI","name":"GDI"},{"id":"SLB","name":"SLB"},{"id":"University of North Carolina","name":"University of North Carolina"},{"id":"Curvenote","name":"Curvenote"},{"id":"Deloitte","name":"Deloitte"},{"id":"Aptos","name":"Aptos"},{"id":"Arm","name":"Arm"}],"contributors":[{"id":"meghann","nameParsed":{"literal":"Meghann Agarwal","given":"Meghann","family":"Agarwal"},"name":"Meghann Agarwal","email":"agarwal.meghann@gmail.com","affiliations":["GDI"]},{"id":"amey","nameParsed":{"literal":"Amey Ambade","given":"Amey","family":"Ambade"},"name":"Amey Ambade","email":"ameyambade@gmail.com","affiliations":["SLB"]},{"id":"chris","nameParsed":{"literal":"Chris Calloway","given":"Chris","family":"Calloway"},"name":"Chris Calloway","email":"cbc@unc.edu","affiliations":["University of North Carolina"]},{"id":"rowan","nameParsed":{"literal":"Rowan Cockett","given":"Rowan","family":"Cockett"},"name":"Rowan Cockett","email":"rowan@curvenote.com","affiliations":["Curvenote"]},{"id":"sanhita","nameParsed":{"literal":"Sanhita Joshi","given":"Sanhita","family":"Joshi"},"name":"Sanhita Joshi","email":"sanhita.joshi@gmail.com","affiliations":["Deloitte"]},{"id":"charles","nameParsed":{"literal":"Charles Lindsey","given":"Charles","family":"Lindsey"},"name":"Charles Lindsey","email":"lindseycster@gmail.com","affiliations":["Aptos"]},{"id":"hongsup","nameParsed":{"literal":"Hongsup Shin","given":"Hongsup","family":"Shin"},"name":"Hongsup Shin","email":"hongsup.shin@pm.me","affiliations":["Arm"]}],"abbreviations":{"MyST":"Markedly Structured Text","AWS":"Amazon Web Services","ML":"Machine Learning","ETL":"Extraction, Transformation, Loading","ARCO":"analysis-ready, cloud-optimized","USV":"Uncrewed Surface Vessel","GUI":"Graphics User Interface","NOAA":"National Oceanic and Atmospheric Administration","NCEI":"National Centers for Environmental Information","AOP":"Aspect-Oriented Programming"},"thumbnail":"https://pub.curvenote.com/0192f9e5-e76d-70ec-b175-9c5b57c04e4a/public/data_collection-b2716ac0cf14e828bc40ced12500ee2a.png","thumbnailOptimized":"https://pub.curvenote.com/0192f9e5-e76d-70ec-b175-9c5b57c04e4a/public/data_collection-b2716ac0cf14e828bc40ced12500ee2a.webp","exports":[{"format":"md","filename":"main.md","url":"https://pub.curvenote.com/0192f9e5-e76d-70ec-b175-9c5b57c04e4a/public/main-b099a1ac7def385eab903199d7e60751.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Motivation","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"exD6ShtoRW"}],"identifier":"motivation","label":"Motivation","html_id":"motivation","implicit":true,"enumerator":"1","key":"TM0PHkOx5i"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Acoustic fisheries surveys and ocean observing systems collect terabytes of echosounder (water column sonar) data that require custom processing pipelines to obtain the distributions and abundance of fish and zooplankton in the ocean ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"WScXMR1VeL"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"cite","identifier":"ncei_story_map","label":"ncei_story_map","kind":"parenthetical","position":{"start":{"line":9,"column":236},"end":{"line":9,"column":251}},"children":[{"type":"text","value":"NOAA National Center for Environmental Information, 2024","key":"j1v6I5ggqj"}],"enumerator":"1","key":"HYJbFfkyg6"}],"key":"IG2H0c0ydO"},{"type":"text","value":". The data are collected by sending an acoustic signal into the ocean which scatters from objects in the water column and the returning “echo” is recorded. Although data usually have similar dimensions: range, time, location, and frequency, and can be stored into multi-dimensional arrays, the exact format varies based on the data collection scheme and the exact instrument used. Fisheries ship surveys, for example, follow pre-defined paths (transects) and can span several months (","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"BTupOApbT8"},{"type":"crossReference","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Figure ","key":"rJdqTOh9Ve"},{"type":"text","value":"1","key":"TB10aoCBdB"}],"identifier":"fig:data_collection","label":"fig:data_collection","kind":"figure","template":"Figure %s","enumerator":"1","resolved":true,"html_id":"fig-data-collection","key":"nEiyHxbZlW"},{"type":"text","value":" left). Ocean moorings, on the other hand, have instruments at fixed locations and can collect data continuously at specified intervals for months (","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"vFKSUOsoza"},{"type":"crossReference","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Figure ","key":"NoYVAb2d2X"},{"type":"text","value":"1","key":"z9mjRyYVyH"}],"identifier":"fig:data_collection","label":"fig:data_collection","kind":"figure","template":"Figure %s","enumerator":"1","resolved":true,"html_id":"fig-data-collection","key":"DaNuMi5u4Q"},{"type":"text","value":" right). Uncrewed Surface Vessels (","key":"prxCzVNHfF"},{"type":"abbreviation","title":"Uncrewed Surface Vessel","children":[{"type":"text","value":"USV","key":"fFwDfIpvYq"}],"key":"pMIW0KZCC1"},{"type":"text","value":"s) (e.g. Saildrone ","key":"v2D9jtHjql"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"cite","identifier":"saildrone","label":"saildrone","kind":"parenthetical","position":{"start":{"line":9,"column":1008},"end":{"line":9,"column":1018}},"children":[{"type":"text","value":"Saildrone, 2024","key":"fmqp9sy5a5"}],"enumerator":"2","key":"SF7snXWcTf"}],"key":"H761PMgAkb"},{"type":"text","value":", DriX ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"aXkg9IpChM"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"cite","identifier":"drix","label":"drix","kind":"parenthetical","position":{"start":{"line":9,"column":1027},"end":{"line":9,"column":1032}},"children":[{"type":"text","value":"DriX, 2024","key":"B4f981XS5Q"}],"enumerator":"3","key":"R4vZttggbT"}],"key":"BnQrlttxGp"},{"type":"text","value":", ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"sT3oofZMMy"},{"type":"crossReference","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Figure ","key":"DmS4fGPnu6"},{"type":"text","value":"1","key":"wyLx1eERmb"}],"identifier":"fig:data_collection","label":"fig:data_collection","kind":"figure","template":"Figure %s","enumerator":"1","resolved":true,"html_id":"fig-data-collection","key":"I0gFhUlMCb"},{"type":"text","value":" middle) can autonomously collect echosounder data over large spatial regions. In all these scenarios, data are usually collected with similar instruments, and there is an overlap between the initial processing procedures. However, there are always variations associated with the specific data collection format, end research needs, data volume, and available computational infrastructure. For example, ship surveys may require grouping data along individual transects and exluding other data; they may also have varying range/depth resulting into data arrays of different dimensions. Mooring data are more regular, but their volume is large, and studies may require organizing data into daily patterns to analyze long term trends. ","key":"bBN3WmQIMK"},{"type":"abbreviation","title":"Uncrewed Surface Vessel","children":[{"type":"text","value":"USV","key":"mPoJcfwh9w"}],"key":"Cd4huVPSOH"},{"type":"text","value":"s collect data at varying speeds thus requiring converting the time dimension to distance in order to have consistent echo patterns. The time when the data needs to be processed also affects the workflows: on premise/realtime applications usually require processing small data subsets at a time with limited computing resources; historical analyses require processing large datasets, and can benefit from cluster/cloud computing. The various scenarios demand different data workflows, and adapting from one setting to another is not trivial.","key":"xv531FDqnm"}],"key":"mKlUQI1W2c"},{"type":"container","kind":"figure","children":[{"type":"image","url":"https://pub.curvenote.com/0192f9e5-e76d-70ec-b175-9c5b57c04e4a/public/data_collection-b2716ac0cf14e828bc40ced12500ee2a.png","alt":"Data Collection Schemes: left, ship survey transect map for the Joint U.S.-Canada Integrated Ecosystem and Pacific Hake Acoustic Trawl Survey ; middle, USV path map for Saildrone west coast survey ; right, map and instrument diagram for a stationary ocean observing system (Ocean Observatories Initiative Cabled and Endurance Arrays , Image Credit: Center for Environmental Visualization, University of Washington)","data":{"altTextIsAutoGenerated":true},"key":"bevJv5lu9J","urlSource":"data_collection.png","urlOptimized":"https://pub.curvenote.com/0192f9e5-e76d-70ec-b175-9c5b57c04e4a/public/data_collection-b2716ac0cf14e828bc40ced12500ee2a.webp"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig:data_collection","identifier":"fig:data_collection","html_id":"fig-data-collection","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"hIpMcfwHM6"},{"type":"text","value":"1","key":"Hnx4etBi3X"},{"type":"text","value":":","key":"Po5Gb7dYID"}],"template":"Figure %s:","key":"xWsKRj9O8Z"},{"type":"strong","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Data Collection Schemes:","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"jcJharDarZ"}],"key":"L7t0As92uR"},{"type":"text","value":" left, ship survey transect map for the Joint U.S.-Canada Integrated Ecosystem and Pacific Hake Acoustic Trawl Survey ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"nuEW5zFlpX"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"cite","identifier":"nwfsc_fram_2022","label":"NWFSC_FRAM_2022","kind":"parenthetical","position":{"start":{"line":13,"column":148},"end":{"line":13,"column":164}},"children":[{"type":"text","value":"Northwest Fisheries Science Center, Fishery Resource Analysis and Monitoring Division, 2022","key":"ZgoqktuOfk"}],"enumerator":"4","key":"tK1JXRsTWm"}],"key":"G1nz17otGC"},{"type":"text","value":"; middle, ","key":"ivifyGJ5YL"},{"type":"abbreviation","title":"Uncrewed Surface Vessel","children":[{"type":"text","value":"USV","key":"AQt48pkUdz"}],"key":"ShhdnuMDU7"},{"type":"text","value":" path map for Saildrone west coast survey ","key":"Y6igvZ90ki"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"cite","identifier":"saildrone_map","label":"saildrone_map","kind":"parenthetical","position":{"start":{"line":13,"column":221},"end":{"line":13,"column":235}},"children":[{"type":"text","value":"Saildrone, 2019","key":"fbl2KX1Llo"}],"enumerator":"5","key":"yOcCsoZu7R"}],"key":"Mx30AckZWM"},{"type":"text","value":"; right, map and instrument diagram for a stationary ocean observing system (Ocean Observatories Initiative Cabled and Endurance Arrays ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"GJVbMAcH8s"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"cite","identifier":"trowbridge_ooi_2019","label":"trowbridge_ooi_2019","kind":"parenthetical","position":{"start":{"line":13,"column":373},"end":{"line":13,"column":393}},"children":[{"type":"text","value":"Trowbridge ","key":"qnKWieM2Qc"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"Dido2SjiGt"}],"key":"uJgKibInhO"},{"type":"text","value":", 2019","key":"uYuYTFBItf"}],"enumerator":"6","key":"Zz845r2I3T"}],"key":"wuBUY19vNu"},{"type":"text","value":", Image Credit: Center for Environmental Visualization, University of Washington)","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"GnEKP3ujBz"}],"key":"lXeUQ64VNA"}],"key":"SHELspIpn3"}],"label":"fig:data_collection","identifier":"fig:data_collection","enumerator":"1","html_id":"fig-data-collection","key":"zQjVwihaR4"},{"type":"heading","depth":2,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Fisheries Acoustics Workflows","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"GdxGzW0sLi"}],"identifier":"fisheries-acoustics-workflows","label":"Fisheries Acoustics Workflows","html_id":"fisheries-acoustics-workflows","implicit":true,"enumerator":"2","key":"S9WqMA5X2V"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Fisheries acoustics scientists traditionally have had go-to tools and procedures for their data processing and analysis, mostly relying on computation on a local computer. However, as the diversity of computing and data storage resources grows and the field becomes more interdisciplinary (it involves scientists with backgrounds in physics, biology, oceanography, acoustics, signal processing, machine learning, software engineering, etc.), it is becoming more challenging to make decisions on the best arrangement to accomplish the work. For example, ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"c1TctgCSUG"},{"type":"crossReference","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Figure ","key":"ACTPriMx6S"},{"type":"text","value":"2","key":"u7Er9cwiZ2"}],"identifier":"fig:workflow_variations","label":"fig:workflow_variations","kind":"figure","template":"Figure %s","enumerator":"2","resolved":true,"html_id":"fig-workflow-variations","key":"YCZnuznazN"},{"type":"text","value":" shows the many variations of workflows that can be defined based on the use cases and the options for data storage and computing infrastructure.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"c1ml4eNvov"}],"key":"KRbyjLNWF8"},{"type":"container","kind":"figure","children":[{"type":"image","url":"https://pub.curvenote.com/0192f9e5-e76d-70ec-b175-9c5b57c04e4a/public/workflow_variations-b0d507434f233317397e3a83b37028ec.png","alt":"Fisheries Acoustics Workflow Variations: Various use cases (fisheries, data management, machine learning, education) drive different needs for data storage and computing infrastructure. Options are abundant but adopting new technology and adapting workflows across use cases is not trivial.","data":{"altTextIsAutoGenerated":true},"key":"On1vmma8Qa","urlSource":"workflow_variations.png","urlOptimized":"https://pub.curvenote.com/0192f9e5-e76d-70ec-b175-9c5b57c04e4a/public/workflow_variations-b0d507434f233317397e3a83b37028ec.webp"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig:workflow_variations","identifier":"fig:workflow_variations","html_id":"fig-workflow-variations","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"WqlYxOVpO6"},{"type":"text","value":"2","key":"UuHHygzBaO"},{"type":"text","value":":","key":"q19bTAn34J"}],"template":"Figure %s:","key":"Kivbyz0H1d"},{"type":"strong","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Fisheries Acoustics Workflow Variations:","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"F6Ih4aTnhf"}],"key":"MoWe8S9EEz"},{"type":"text","value":" Various use cases (fisheries, data management, machine learning, education) drive different needs for data storage and computing infrastructure. Options are abundant but adopting new technology and adapting workflows across use cases is not trivial.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"IDr3F1LdG6"}],"key":"nz2TeIYOas"}],"key":"L0UwQTmiYe"}],"label":"fig:workflow_variations","identifier":"fig:workflow_variations","enumerator":"2","html_id":"fig-workflow-variations","key":"jXkh2Fl79j"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"User Stories","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"MxDsTLpLrX"}],"identifier":"user-stories","label":"User Stories","html_id":"user-stories","implicit":true,"enumerator":"2.1","key":"nzlP4jEVac"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"To demonstrate the software requirements of the fisheries acoustics community, below we describe several example user stories.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"AV9dSpGHex"}],"key":"BnM30z9qaX"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"A ","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Be5qUNcAhZ"},{"type":"strong","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"fisheries scientist","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"tiUBqGdAow"}],"key":"pVT8YqcX0X"},{"type":"text","value":" needs to process all data after a 2-month ship survey to obtain fish biomass estimates. They have previously used a commercial software package and are open to exploring open-source tools to achieve the same goal. They are familiar with basic scripting in Python.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"zUzEqX9gAp"}],"key":"LozANfkAQs"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"A ","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"AsdB3uX7RK"},{"type":"strong","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"machine learning engineer","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"bURmIUbV6J"}],"key":"tgncF7o616"},{"type":"text","value":" is developing an ","key":"I0xKdDV9qB"},{"type":"abbreviation","title":"Machine Learning","children":[{"type":"text","value":"ML","key":"Gj1GdQcvMp"}],"key":"sl3xM0PsAq"},{"type":"text","value":" algorithm to automatically detect fish on a ","key":"AVhf1X10Z1"},{"type":"abbreviation","title":"Uncrewed Surface Vessel","children":[{"type":"text","value":"USV","key":"EznNnW5kDo"}],"key":"hASOZSax2b"},{"type":"text","value":". They need to prepare a large dataset for training but do not know all the necessary preprocessing steps. They are very familiar with ","key":"Z3S3Bij7u7"},{"type":"abbreviation","title":"Machine Learning","children":[{"type":"text","value":"ML","key":"mOx96dFdB8"}],"key":"oBjqMKhHnl"},{"type":"text","value":" libraries but do not have the domain-specific knowledge for acoustic data processing. They are also not familiar with distributed computing libraries.","key":"WNhCzyCl6q"}],"key":"rnPCjIuviy"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"A ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"R7Tu57kjLN"},{"type":"strong","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"data manager","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"emOnToUvr6"}],"key":"fPCtMBFQDC"},{"type":"text","value":" wants to process several terabytes of mooring data and serve them to the scientific community. They have a few Python scripts to do this for a small set of files at a time, but want to scale the processing for many deployments using a cloud infrastructure.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"vsofxWhmSk"}],"key":"eHqWmWCIxd"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"An ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"NJ4Ucf88OB"},{"type":"strong","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"acoustics graduate student","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"xK8KirBhzt"}],"key":"AqrZq7SLkM"},{"type":"text","value":" obtained echosounder data analysis scripts from a retired scientist but does not have all the parameters needed to reproduce the results in order to proceed with their dissertation research.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"MSB1rkIo0q"}],"key":"Uxt9s6mBuG"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"We draw attention to the different levels of experience of these users: each user has expertise in a subdomain, however, to accomplish their specific goal(s), they need to learn new tools or obtain knowledge from others. We outline several requirements that stem from these stories:","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"zdwNF8X4oe"}],"key":"NlJfuA9eyn"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":39,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"The system should run both on a local computer and within a cloud environment.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"BcJdGKvAZ1"}],"key":"U9bzgB9U5R"},{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"The system should allow processing to be scaled to large datasets, but should not be overly complicated. For example, users with Python scripting experience can run it locally with pre-defined stages and parameters.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"Xgzj1x3P5F"}],"key":"LLwwNJRzUJ"},{"type":"listItem","spread":true,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"The system should provide visibility into the operations that are applied to the data, and the procedures should be interpretable to users without acoustics expertise.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"iBHT4e1pFS"}],"key":"MkWcKuqGKc"},{"type":"listItem","spread":true,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"The system should preferably be free and open source so that it is accessible to members of different institutions.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"LYQznVAfok"}],"key":"GTJKAeoNVl"},{"type":"listItem","spread":true,"position":{"start":{"line":43,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"The system should adapt to rapid changes of cloud and distributed computing libraries, and preferably should leverage existing developments within the technical communities.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"iH07HiFc4n"}],"key":"aofActv7wb"}],"key":"hWDUzf3cql"},{"type":"heading","depth":3,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Software Landscape","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"KlXr0fPF1K"}],"identifier":"software-landscape","label":"Software Landscape","html_id":"software-landscape","implicit":true,"enumerator":"2.2","key":"DFzGYdSC24"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Traditionally echosounder data processing pipelines are executed within a ","key":"onAX9TkVYg"},{"type":"abbreviation","title":"Graphics User Interface","children":[{"type":"text","value":"GUI","key":"EBuxPnVGps"}],"key":"NNl9ImLIiO"},{"type":"text","value":"-based software (e.g. Echoview ","key":"Zethlhkw06"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"echoview_software_pty_ltd_echoview_nodate","label":"echoview_software_pty_ltd_echoview_nodate","kind":"parenthetical","position":{"start":{"line":47,"column":110},"end":{"line":47,"column":152}},"children":[{"type":"text","value":"Echoview Software Pty Ltd, 2020","key":"b5oj8WBAXO"}],"enumerator":"7","key":"FV3i20jlhY"}],"key":"sP9py9P9jT"},{"type":"text","value":", LSSS ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"JH13npGRJ5"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"korneliussen_lsss_2006","label":"korneliussen_lsss_2006","kind":"parenthetical","position":{"start":{"line":47,"column":161},"end":{"line":47,"column":184}},"children":[{"type":"text","value":"Korneliussen ","key":"fCwqPc04yK"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"w4EAZqtO1m"}],"key":"wqICy3855M"},{"type":"text","value":", 2006","key":"qzBiqxY299"}],"enumerator":"8","key":"dkybgFhagq"}],"key":"oB3plN33th"},{"type":"text","value":", ESP3 ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"ayTXvRQsQ1"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"ladroit_esp3_2020","label":"ladroit_esp3_2020","kind":"parenthetical","position":{"start":{"line":47,"column":193},"end":{"line":47,"column":211}},"children":[{"type":"text","value":"Ladroit ","key":"WplrkTvWTG"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"fACypvVKS3"}],"key":"mABzmEF9B5"},{"type":"text","value":", 2020","key":"PhfuFtIk43"}],"enumerator":"9","key":"NEZRisRUMg"}],"key":"fi9MwtmbFV"},{"type":"text","value":", Matecho ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"yhDxQgkxe7"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"perrot_matecho_2018","label":"perrot_matecho_2018","kind":"parenthetical","position":{"start":{"line":47,"column":223},"end":{"line":47,"column":243}},"children":[{"type":"text","value":"Perrot ","key":"gaH6id8S7h"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"A5wZ2KOELt"}],"key":"kQJHJqpQnF"},{"type":"text","value":", 2018","key":"OMywtuSyvj"}],"enumerator":"10","key":"GeMxDFL8c3"}],"key":"QajkaPkaJu"},{"type":"text","value":"). These software packages have been invaluable for onboard real-time visualization, as well as post-survey data screening and annotation. Some of them also support integration with scripting tools which facilitates the reproducible execution of the pipelines. For example, the Echoview software provides the option to automate pipelines through an Automation Module and to visualize the processing stages in a Dataflow Toolbox. Further, one can script operations through the ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"z3lsi9EQ0H"},{"type":"inlineCode","value":"echoviewR","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"hvpJUuFOCk"},{"type":"text","value":" package ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"xR25XaTCrY"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"harrison_echoviewr_2015","label":"harrison_echoviewR_2015","kind":"parenthetical","position":{"start":{"line":47,"column":741},"end":{"line":47,"column":765}},"children":[{"type":"text","value":"Harrison ","key":"AOVENy1KMl"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"V79LQU286X"}],"key":"lFZphKRw7v"},{"type":"text","value":", 2015","key":"sKLmldHMcy"}],"enumerator":"11","key":"AiCuS1Vr0Y"}],"key":"vhgtfydNDa"},{"type":"text","value":". However, since Echoview is neither free nor open source, these pipelines cannot be shared with researchers who do not have a license. In general, the ","key":"Itpxk26cIb"},{"type":"abbreviation","title":"Graphics User Interface","children":[{"type":"text","value":"GUI","key":"bDtlr8uUri"}],"key":"nuZdr4xOyd"},{"type":"text","value":" tools are usually designed to be used on a desktop computer and require downloading the data first, which is becoming challenging with the growing volume of the datasets. There has been also growth in development of new methods to detect the species of interest from the echosounder data, with the goal of substituting for the manual annotation procedures and making analysis of large datasets more efficient and objective. However, the new methods are typically developed independently from the existing software packages.\nOver the last several years there has been substantial development of open source Python packages (PyEchoLab ","key":"YbYJ2Wklog"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"wall_pyecholab_2018","label":"wall_pyecholab_2018","kind":"parenthetical","position":{"start":{"line":47,"column":1556},"end":{"line":47,"column":1576}},"children":[{"type":"text","value":"Wall ","key":"FApy1Hw3c9"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"BEPvH3hyRT"}],"key":"f4c06ziJGP"},{"type":"text","value":", 2018","key":"nkcvIiCMFJ"}],"enumerator":"12","key":"MAcCsdJjrA"}],"key":"Ds0NuaaZGX"},{"type":"text","value":", ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"cKMsvuuurg"},{"type":"inlineCode","value":"echopype","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"hytd7d4Lk8"},{"type":"text","value":" ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"qxrQ3L0vlY"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"lee_echopype_2021","label":"lee_echopype_2021","kind":"parenthetical","position":{"start":{"line":47,"column":1591},"end":{"line":47,"column":1609}},"children":[{"type":"text","value":"Lee ","key":"OWzin9P0l2"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"hH0DoAnrgQ"}],"key":"zGkKpu5zXh"},{"type":"text","value":", 2021","key":"XjcUD7o2O6"}],"enumerator":"13","key":"bTs3f7szmt"}],"key":"FY8fQMqXdb"},{"type":"text","value":", ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"nqI87WcGvo"},{"type":"inlineCode","value":"echopy","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"chIhP3Ajz2"},{"type":"text","value":" ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"hxtArMGbm0"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"echopy_2024","label":"echopy_2024","kind":"parenthetical","position":{"start":{"line":47,"column":1622},"end":{"line":47,"column":1634}},"children":[{"type":"text","value":"open-ocean-sounding/echopy, 2024","key":"wx6xMo0Ouj"}],"enumerator":"14","key":"RxUw1pUn4c"}],"key":"Hyh5ln41DU"},{"type":"text","value":"), each providing common echosounder processing functionalities, but differing in the data structure organization and processing. Since echosounder instruments store the data in binary, instrument-specific formats, the first stage requires parsing the raw data into a more common format. PyEcholab converts the data into ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"GY3VcmbHdM"},{"type":"inlineCode","value":"numpy","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"hhOsCpauNU"},{"type":"text","value":" ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"Ne9hq9dnCb"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"numpy","label":"numpy","kind":"parenthetical","position":{"start":{"line":47,"column":1965},"end":{"line":47,"column":1971}},"children":[{"type":"text","value":"Harris ","key":"nIfcBcyutf"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"uVDylR7ZsK"}],"key":"tgnEPNdEqU"},{"type":"text","value":", 2020","key":"vIaohqgP0K"}],"enumerator":"15","key":"a5Slyj1IBA"}],"key":"RBaYf3iRhf"},{"type":"text","value":" arrays. ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"PUN0OWBWOv"},{"type":"inlineCode","value":"echopy","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"ufmKvJfFdT"},{"type":"text","value":" expects data are already parsed into ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"IBLuzLYAMs"},{"type":"inlineCode","value":"numpy","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"MHp545j5tR"},{"type":"text","value":" arrays and all methods operate on them. Echopype converts raw data files into a standardized Python ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"bjAeTPywwt"},{"type":"inlineCode","value":"EchoData","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"FSLWQelWjL"},{"type":"text","value":" object, which can be stored in a ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"FeytNO13sb"},{"type":"inlineCode","value":"zarr","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"T4fWRN5JzW"},{"type":"text","value":" ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"s9Hv4G3SAe"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"zarr","label":"zarr","kind":"parenthetical","position":{"start":{"line":47,"column":2187},"end":{"line":47,"column":2192}},"children":[{"type":"text","value":"Miles ","key":"pvLf6edVaO"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"tvro28u7vC"}],"key":"a8KDILcxVA"},{"type":"text","value":", 2024","key":"tnWk79jyvz"}],"enumerator":"16","key":"xin0mBoIij"}],"key":"WaFb8RlPK9"},{"type":"text","value":" format and supports distributed computing by utilizing ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"GyuYwK56Hg"},{"type":"inlineCode","value":"dask","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"foUBAeCviN"},{"type":"text","value":" ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"mzampUjC2H"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"dask","label":"dask","kind":"parenthetical","position":{"start":{"line":47,"column":2257},"end":{"line":47,"column":2262}},"children":[{"type":"text","value":"Dask Development Team, 2016","key":"lgOpb245kk"}],"enumerator":"17","key":"UqnztWMinQ"}],"key":"cPC1trmcbI"},{"type":"text","value":" and ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"F3m7orEvY9"},{"type":"inlineCode","value":"xarray","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"wl7kT6LdiP"},{"type":"text","value":" ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"vP3mIdbb9o"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"xarray","label":"xarray","kind":"parenthetical","position":{"start":{"line":47,"column":2278},"end":{"line":47,"column":2285}},"children":[{"type":"text","value":"Hoyer \u0026 Hamman, 2017","key":"XFA1u9Nu1x"}],"enumerator":"18","key":"PLd8julXJ7"}],"key":"hByshd3OYm"},{"type":"text","value":". The use of open source packages and well-established formats allow further integration with other open source libraries such as those for machine learning (e.g. classification, clustering) or visualization. In addition, if custom modification is required for a specific application scenario, researchers can adapt the code and contribute the modification back to the packages, which is likely to benefit other researchers.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"eyieT3xvww"}],"key":"ZkkDLFtxMJ"},{"type":"heading","depth":4,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Challenges","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"MlwK076KxY"}],"identifier":"challenges","label":"Challenges","html_id":"challenges","implicit":true,"enumerator":"2.2.1","key":"m6H0gPLYSF"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Despite the availability of methods and tools to process echosounder data, it is not trivial to orchestrate all function calls in an end-to-end pipeline. While a well-documented Jupyter ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"fReBdPedvL"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"cite","identifier":"jupyter","label":"jupyter","kind":"parenthetical","position":{"start":{"line":52,"column":188},"end":{"line":52,"column":196}},"children":[{"type":"text","value":"Kluyver ","key":"o1Vp3EzNTC"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"DXqqHRxCPm"}],"key":"Kz07WnGCc8"},{"type":"text","value":", 2016","key":"MzmYhsLnPe"}],"enumerator":"19","key":"NyYge6EmUb"}],"key":"RRZpxBhyWT"},{"type":"text","value":" notebook can show the sequence of processing stages, a considerable amount of path and parameter configuration is required to execute these stages on a large dataset, store the intermediate data products, and log the process comprehensively. Although automation can be achieved through a combination of Python and bash scripts that provision the environment, execute the stages, and manage inputs/outputs, the configuration process can be tedious, prone to error, and specific to the use case and the computing platform. Adapting an existing procedure to a new setting is usually not straightforward, and sometimes even reproducing previous results can pose a challenge. Below we discuss in more detail the different choices of data storage and computational infrastructure and the associated challenges of building workflows across them.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"vdJcsiyWzL"}],"key":"eTbemii3fZ"},{"type":"heading","depth":5,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Data Storage","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"fqzqOnn8tX"}],"identifier":"data-storage","label":"Data Storage","html_id":"data-storage","implicit":true,"enumerator":"2.2.1.1","key":"pLuoer2epq"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"Researchers are faced with decisions of where to store the data from experiments, intermediate products, and final results. Initially, data are usually stored on local hard drive storage associated with the instrument (which on some platforms may have limited capacity), but eventually, these data may be transferred to a data archive if one is maintained within the community. Some agencies (e.g. ","key":"UXeLyFLk7R"},{"type":"abbreviation","title":"National Oceanic and Atmospheric Administration","children":[{"type":"text","value":"NOAA","key":"K6S2V9KtLV"}],"key":"QDfejyIlvB"},{"type":"text","value":" National Centers for Environmental Information (","key":"J8UgMflfWP"},{"type":"abbreviation","title":"National Centers for Environmental Information","children":[{"type":"text","value":"NCEI","key":"dPeN8x3xxR"}],"key":"gt2BqrIzop"},{"type":"text","value":") ","key":"NT5BRY3KYg"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"cite","identifier":"wall_2016","label":"wall_2016","kind":"parenthetical","position":{"start":{"line":56,"column":459},"end":{"line":56,"column":469}},"children":[{"type":"text","value":"Wall, 2016","key":"PgPfHMucyh"}],"enumerator":"20","key":"Xz17ENQJrr"}],"key":"wjmlqJ528e"},{"type":"text","value":") have adopted cloud storage, and have publicly shared their data, which greatly facilitates data access and reuse. However, those repositories are usually not where researchers can store processed products. Funding models and organizational structure can result in short-term availability of resources and the need to change providers. Certain applications may need to access the data before they are archived and unreliable internet connection may require storing the data on-premise or at temporary locations. ","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"jF6uHiH7dN"},{"type":"emphasis","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"To be agile to those frequent changes and allow to easily switch between different platforms, workflows will benefit from a level of abstraction from storage systems.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"Ih23a285na"}],"key":"OW75qAOaJH"}],"key":"EgveNVJWJl"},{"type":"heading","depth":5,"position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Computing Infrastructure","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"yB738gWw4j"}],"identifier":"computing-infrastructure","label":"Computing Infrastructure","html_id":"computing-infrastructure","implicit":true,"enumerator":"2.2.1.2","key":"PB1N6pR6S1"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"With the growth of the echosounder datasets, researchers face challenges processing the data on their personal machines: both in terms of memory usage and computational time. A typical first attempt for resolution would be to amend the workflow to process smaller chunks of the data and parallelize operations across multiple cores if available. However, today researchers are also presented with a multitude of options for distributed computing: high-performance computing clusters at local or national institutions, cloud provider services: batch computing (e.g. Azure Batch, ","key":"Dic4KGCrAU"},{"type":"abbreviation","title":"Amazon Web Services","children":[{"type":"text","value":"AWS","key":"YlVEJKrKDU"}],"key":"HHq7iGEMyJ"},{"type":"text","value":" Batch, Google Cloud Batch), container services (e.g. Amazon Elastic Container Services, Azure Container Apps, Google Kubernetes Engine), serverless functions (e.g. ","key":"DjrD9ycZey"},{"type":"abbreviation","title":"Amazon Web Services","children":[{"type":"text","value":"AWS","key":"tGiwfEPAzN"}],"key":"WTB9apgLAp"},{"type":"text","value":" Lamdba Functions, Google Cloud Functions, Microsoft Azure Functions). The choice may be driven by the storage system: its usage fees and retrieval speeds. Data, code and workflow organization usually has to be adapted based on the computing infrastructure. The knowledge required to configure these systems to achieve efficient processing is quite in-depth, and distributed libraries can be hard to debug and can have unexpected performance bottlenecks. ","key":"bLILoctZMk"},{"type":"emphasis","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Abstracting the computing infrastructure and the execution of the tasks can allow researchers to focus on the scientific analysis of these large and rich datasets.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"UIUCK6vLxc"}],"key":"LRnELbFu2L"}],"key":"mZjPzx2K36"},{"type":"heading","depth":2,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"Echodataflow Overview","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"EHBBoqNzh7"}],"identifier":"echodataflow-overview","label":"Echodataflow Overview","html_id":"echodataflow-overview","implicit":true,"enumerator":"3","key":"o1ouxmycFd"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"At the center of ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"Ufh7n1lrmA"},{"type":"inlineCode","value":"echodataflow","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"M0tMSVDItr"},{"type":"text","value":"’s design ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"QOVE73p1sG"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"cite","identifier":"echodataflow","label":"echodataflow","kind":"parenthetical","position":{"start":{"line":64,"column":43},"end":{"line":64,"column":56}},"children":[{"type":"text","value":"Echodataflow, 2024","key":"vkJ9MW7WDm"}],"enumerator":"21","key":"fowT4LFFfj"}],"key":"AMSz3ngrfs"},{"type":"text","value":" is the notion that a workflow can be configured through a set of recipes (","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"BsWwZ6Te3h"},{"type":"inlineCode","value":".yaml","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"KgYxsIxa63"},{"type":"text","value":" files) that specify the pipeline, data storage, and logging structure. The idea draws inspiration from the Pangeo-Forge Project which facilitates the Extraction, Transformation, Loading (","key":"Vy4bFg4o2O"},{"type":"abbreviation","title":"Extraction, Transformation, Loading","children":[{"type":"text","value":"ETL","key":"U6O5NbDSCp"}],"key":"K4K12WFOLj"},{"type":"text","value":") of earth science geospatial datasets from traditional repositories to analysis-ready, cloud-optimized (","key":"it741x5Ke3"},{"type":"abbreviation","title":"analysis-ready, cloud-optimized","children":[{"type":"text","value":"ARCO","key":"rCqwNcpam3"}],"key":"IZAnAV3QB4"},{"type":"text","value":") data stores ","key":"gK9CvR2mpG"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"cite","identifier":"pangeo-forge","label":"pangeo-forge","kind":"parenthetical","position":{"start":{"line":64,"column":454},"end":{"line":64,"column":467}},"children":[{"type":"text","value":"Stern ","key":"JTVnEWqxDx"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"CApXNZzXk8"}],"key":"doKVoRS57u"},{"type":"text","value":", 2022","key":"Z1z4gGKHyA"}],"enumerator":"22","key":"XBi6jBqXu5"}],"key":"U81SUv4EUo"},{"type":"text","value":". The pangeo-forge recipes (which themselves are inspired by the conda-forge recipes ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"daMMUnz1eK"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"cite","identifier":"conda_forge_community_2015_4774216","label":"conda_forge_community_2015_4774216","kind":"parenthetical","position":{"start":{"line":64,"column":554},"end":{"line":64,"column":589}},"children":[{"type":"text","value":"conda-forge community, 2015","key":"M71NO8Hjsc"}],"enumerator":"23","key":"YSwf7hWS0b"}],"key":"QHYcNyBlBB"},{"type":"text","value":") provide a model of how the data should be accessed and transformed, and the project has garnered numerous recipes from the community.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"Aiw1hbyuxr"}],"key":"TmAXlmIhLu"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"While Pangeo-Forge’s focus is on transformation from ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"Nmedo2HfOz"},{"type":"inlineCode","value":"netcdf","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"O4GsG1noUz"},{"type":"text","value":" ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"lzM27WOKu3"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"cite","identifier":"netcdf","label":"netcdf","kind":"parenthetical","position":{"start":{"line":66,"column":64},"end":{"line":66,"column":71}},"children":[{"type":"text","value":"Rew \u0026 Davis, 1990","key":"UMjMjxOQMB"}],"enumerator":"24","key":"R4kdA83cTM"}],"key":"OqIV0mIbdj"},{"type":"text","value":" and ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"gf31DGroj9"},{"type":"inlineCode","value":"hdf5","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"pv5FKRADhM"},{"type":"text","value":" ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"FSeOsnPDPh"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"cite","identif