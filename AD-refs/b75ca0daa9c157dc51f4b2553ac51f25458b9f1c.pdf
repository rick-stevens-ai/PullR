-7f13-8d7f-ece80ac200fd","submission_version_id":"0192f9e6-519d-7647-9d72-dffd725e9bb2","cdn":"https://pub.curvenote.com/","cdn_key":"0192f9e5-e76d-70ec-b175-9c5b57c04e4a","slug":"JXDK4427","doi":"10.25080/JXDK4427","key":"scipy-2024-valentina_staneva","title":"Echodataflow: Recipe-based Fisheries Acoustics Workflow Orchestration","description":"With the influx of large data from multiple instruments and experiments, scientists are wrangling complex data pipelines that are context-dependent and non-reproducible. Echodataflow provides transparent reproducible pipelines that can be edited with text \"recipes\", scaled and monitored.","authors":[{"name":"Valentina Staneva"},{"name":"Soham Butala"},{"name":"Landung (Don) Setiawan"},{"name":"Wu-Jung Lee"}],"canonical":true,"date_created":"2024-11-05T01:17:53.056Z","date":"2024-07-10","date_published":"2024-07-10","kind":{"id":"018cee8a-d81b-770e-af3a-f92f6e0fb397","name":"article","content":{"title":"Article","description":"A proceedings article"},"default":true},"collection":{"id":"018ebf20-1865-71f2-b295-5afd6c600e47","name":"2024","slug":"2024","workflow":"SIMPLE","content":{"title":"SciPy 2024","description":"Proceedings of the Python in Science Conference 2024"},"open":true},"links":{"self":"https://journals.curvenote.com/v1/sites/scipy/works/018fcfd9-c85a-757d-93ea-e5c1d22f19d4/versions/0192f9e6-4e20-7f13-8d7f-ece80ac200fd","site":"https://journals.curvenote.com/v1/sites/scipy","work":"https://journals.curvenote.com/v1/works/018fcfd9-c85a-757d-93ea-e5c1d22f19d4","thumbnail":"https://journals.curvenote.com/v1/sites/scipy/works/018fcfd9-c85a-757d-93ea-e5c1d22f19d4/versions/0192f9e6-4e20-7f13-8d7f-ece80ac200fd/thumbnail","social":"https://journals.curvenote.com/v1/sites/scipy/works/018fcfd9-c85a-757d-93ea-e5c1d22f19d4/versions/0192f9e6-4e20-7f13-8d7f-ece80ac200fd/social","config":"https://pub.curvenote.com/0192f9e5-e76d-70ec-b175-9c5b57c04e4a/config.json","doi":"https://doi.org/10.25080/JXDK4427"}}}},"actionData":null