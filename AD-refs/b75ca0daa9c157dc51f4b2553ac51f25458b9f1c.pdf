":{"line":419,"column":1}},"children":[{"type":"text","value":"Our immediate goal is to provide more example workflow recipes integrating other stages of echosounder data processing, such as machine learning prediction, training dataset generation, biomass estimation, interactive visualization, etc. We will demonstrate utilizing functionalities from a suite of open source Python packages (","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"yJG33xng9l"},{"type":"inlineCode","value":"echoregions","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"URkju42RDO"},{"type":"text","value":" ","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"Ey2m9eaNA9"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"children":[{"type":"cite","identifier":"echoregions","label":"echoregions","kind":"parenthetical","position":{"start":{"line":419,"column":345},"end":{"line":419,"column":357}},"children":[{"type":"text","value":"Nguyen ","key":"aL9jN29yPy"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"k0TJlBJHqU"}],"key":"bNkv8NAXh3"},{"type":"text","value":", 2023","key":"rhMWtheHVK"}],"enumerator":"38","key":"dgTJ4CsMyt"}],"key":"rAr44Eg1tZ"},{"type":"text","value":" for reading region annotations and creating corresponding masks, ","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"uo5DIjSXI2"},{"type":"inlineCode","value":"echopop","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"kopASSYbSj"},{"type":"text","value":" ","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"MERV8u4YfH"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"children":[{"type":"cite","identifier":"echopop","label":"echopop","kind":"parenthetical","position":{"start":{"line":419,"column":435},"end":{"line":419,"column":443}},"children":[{"type":"text","value":"Lucca ","key":"NbYPMrzf7A"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"am6HJ6oUAr"}],"key":"r2z3u57qyu"},{"type":"text","value":", 2024","key":"Vi2AOLyJqT"}],"enumerator":"39","key":"Sm38vjgWKA"}],"key":"C2dwQaSTwm"},{"type":"text","value":" for combining acoustic data with biological “ground truth” into biomass estimation, ","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"jZhTK2Tqwx"},{"type":"inlineCode","value":"echoshader","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"djRzdg5OC7"},{"type":"text","value":" ","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"wpSo0QMh2l"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"children":[{"type":"cite","identifier":"echoshader","label":"echoshader","kind":"parenthetical","position":{"start":{"line":419,"column":543},"end":{"line":419,"column":554}},"children":[{"type":"text","value":"Lei ","key":"njvbnbhbRe"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"N9diyoyiGl"}],"key":"ACdimY3dP5"},{"type":"text","value":", 2024","key":"jRVhxqh9DN"}],"enumerator":"40","key":"lv07zfigs3"}],"key":"U9d6uathgl"},{"type":"text","value":" for echogram and map dashboard visualization) in building workflows for the Pacific Hake Survey: both in a historical and near-realtime on-ship data processing context. We aim to streamline the stage addition process. We will further investigate how to improve memory management and caching between and within stages to optimize for different scenarios. There is growing interest in the fisheries acoustics community to share global, accessible, and interoperable datasets ","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"a17hWirASw"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"children":[{"type":"cite","identifier":"gain_repo","label":"gain_repo","kind":"parenthetical","position":{"start":{"line":419,"column":1030},"end":{"line":419,"column":1040}},"children":[{"type":"text","value":"ICES Working Group on Global Acoustic Interoperable Network (GAIN), n.d.","key":"XgtY9wMyYN"}],"enumerator":"41","key":"G16kz7INrE"}],"key":"CGvUeM7HoJ"},{"type":"text","value":", and to agree on community data standards and definitions of processing levels ","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"xAmVyY2Luy"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"children":[{"type":"cite","identifier":"convention","label":"convention","kind":"parenthetical","position":{"start":{"line":419,"column":1122},"end":{"line":419,"column":1133}},"children":[{"type":"text","value":"Macaulay \u0026 Peña, 2018","key":"lJe2eAJ0OS"}],"enumerator":"37","key":"l564Ocy92t"}],"key":"hAAJU1RNUF"},{"type":"text","value":", ","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"VJmcCrxDJc"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"children":[{"type":"cite","identifier":"levels","label":"levels","kind":"parenthetical","position":{"start":{"line":419,"column":1137},"end":{"line":419,"column":1144}},"children":[{"type":"text","value":"Echosounder Data Processing Levels, n.d.","key":"mp59Q7QVSX"}],"enumerator":"42","key":"KnukjsI9Ei"}],"key":"cOfK4mt71l"},{"type":"text","value":". As those mature we will align them with existing stages in ","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"yiCI1IUtWg"},{"type":"inlineCode","value":"echodataflow","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"CJSNfjT5io"},{"type":"text","value":", which will support building interoperable datasets whose integration will push us to study bigger and more challenging questions in fisheries acoustics.","position":{"start":{"line":419,"column":1},"end":{"line":419,"column":1}},"key":"HQgjd7Lro4"}],"key":"juSdmLNynC"},{"type":"heading","depth":2,"position":{"start":{"line":421,"column":1},"end":{"line":421,"column":1}},"children":[{"type":"text","value":"Beyond Fisheries Acoustics","position":{"start":{"line":421,"column":1},"end":{"line":421,"column":1}},"key":"TsqFHPREMq"}],"identifier":"beyond-fisheries-acoustics","label":"Beyond Fisheries Acoustics","html_id":"beyond-fisheries-acoustics","implicit":true,"enumerator":"12","key":"KbIqbGHecx"},{"type":"paragraph","position":{"start":{"line":423,"column":1},"end":{"line":423,"column":1}},"children":[{"type":"text","value":"Echodataflow was designed to facilitate fisheries acoustics workflows, but the structure can be adapted to data processing pipelines in other scientific communities. The key aspects are to identify the potential stages of the workflows and associated Python packages/functions that implement them, and to design the structure of the configuration files. The other aspects such as logging, deployment, monitoring, new-stage integration are domain-agnostic. Processing pipelines that require manipulation of large labeled arrays can directly benefit from the Dask cluster integration and are prevalent in the research community. Our use case of regrouping data based on time segments is a common need within scientific settings in which the file unit level of the instrument is not aligned with the unit level of analysis, and requires further reorganization and potential resampling and regridding along certain coordinates. We hope it can serve as a guide on how to build configurable, reproducible, and scalable workflows in new scientific areas.","position":{"start":{"line":423,"column":1},"end":{"line":423,"column":1}},"key":"l6rJE3jC9p"}],"key":"XJ1TiTXV0u"},{"type":"heading","depth":2,"position":{"start":{"line":425,"column":1},"end":{"line":425,"column":1}},"children":[{"type":"text","value":"Acknowledgements","position":{"start":{"line":425,"column":1},"end":{"line":425,"column":1}},"key":"sJPpxlVCeQ"}],"identifier":"acknowledgements","label":"Acknowledgements","html_id":"acknowledgements","implicit":true,"enumerator":"13","key":"fdVfGa6hNs"},{"type":"paragraph","position":{"start":{"line":427,"column":1},"end":{"line":427,"column":1}},"children":[{"type":"text","value":"We thank the Fisheries Engineering and Acoustic Technologies team at the ","key":"lweKpX6Xd9"},{"type":"abbreviation","title":"National Oceanic and Atmospheric Administration","children":[{"type":"text","value":"NOAA","key":"iUcEMyAEeG"}],"key":"QycGNC8jOH"},{"type":"text","value":" Northwest Fisheries Science Center: Julia Clemons, Alicia Billings, Rebecca Thomas, Elizabeth Phillips for introducing us to the Pacific Hake Survey operations and the hake biomass estimation workflow.","key":"LEqusv3ew8"}],"key":"XKS3m3W7bw"},{"type":"paragraph","position":{"start":{"line":429,"column":1},"end":{"line":429,"column":1}},"children":[{"type":"text","value":"This work used cpu compute and storage resources at Jetstream2 through allocation AGR230002 from the Advanced cyberinfrastructure Coordination Ecosystem: Services \u0026 Support (ACCESS) program ","position":{"start":{"line":429,"column":1},"end":{"line":429,"column":1}},"key":"ULcS7kWPCi"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":429,"column":1},"end":{"line":429,"column":1}},"children":[{"type":"cite","identifier":"10.1145/3437359.3465565","label":"10.1145/3437359.3465565","kind":"parenthetical","position":{"start":{"line":429,"column":192},"end":{"line":429,"column":216}},"children":[{"type":"text","value":"Hancock ","key":"Hh4H7YgX7H"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"bSbSbKSQQf"}],"key":"vrk6i8esez"},{"type":"text","value"