mework: The above diagram provides an overview of the echodataflow framework: the objective is to fetch raw files from a local filesystem/cloud archive, process them through several stages of an echosounder data workflow using a cluster infrastructure, and store both intermediate and final data products. In echodataflow the workflow is executed based on text configurations, and logs are generated for the individual processing stages. Prefect handles the execution of the tasks on the cluster and provides tools for monitoring the workflow runs.","data":{"altTextIsAutoGenerated":true},"key":"ZDco2Jt7ly","urlSource":"echodataflow.png","urlOptimized":"https://pub.curvenote.com/0192f9e5-e76d-70ec-b175-9c5b57c04e4a/public/echodataflow-b1a8e4a3a2c822ecf6073a1eba0c9568.webp"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig:echodataflow_overview","identifier":"fig:echodataflow_overview","html_id":"fig-echodataflow-overview","enumerator":"3","children":[{"type":"text","value":"Figure ","key":"vPB7JE197e"},{"type":"text","value":"3","key":"Rz0vFCpaZD"},{"type":"text","value":":","key":"o5rLmDUUs1"}],"template":"Figure %s:","key":"OEaixTRHuY"},{"type":"strong","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Echodataflow Framework:","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"nqbJHxbpPY"}],"key":"XhLTWngYh5"},{"type":"text","value":" The above diagram provides an overview of the ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"zXU1mK7n8Q"},{"type":"inlineCode","value":"echodataflow","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"hNUmm6hyFt"},{"type":"text","value":" framework: the objective is to fetch raw files from a local filesystem/cloud archive, process them through several stages of an echosounder data workflow using a cluster infrastructure, and store both intermediate and final data products. In ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"xXkWtQkYDV"},{"type":"inlineCode","value":"echodataflow","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"VHIZf1rEii"},{"type":"text","value":" the workflow is executed based on text configurations, and logs are generated for the individual processing stages. Prefect handles the execution of the tasks on the cluster and provides tools for monitoring the workflow runs.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"sKeebW917O"}],"key":"CL1sRdcW82"}],"key":"eBGjIMm11c"}],"label":"fig:echodataflow_overview","identifier":"fig:echodataflow_overview","enumerator":"3","html_id":"fig-echodataflow-overview","key":"nAv8YnndwQ"},{"type":"heading","depth":3,"position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"Why Prefect?","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"VXrIiH7BnM"}],"identifier":"why-prefect","label":"Why Prefect?","html_id":"why-prefect","implicit":true,"enumerator":"3.1","key":"wkGebb4S6k"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"We chose Prefect among other Python workflow orchestration frameworks such as Apache Airflow ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"ioGyncKkIm"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"cite","identifier":"airflow","label":"airflow","kind":"parenthetical","position":{"start":{"line":75,"column":95},"end":{"line":75,"column":103}},"children":[{"type":"text","value":"Apache Airflow, 2024","key":"tOUMYJhVpt"}],"enumerator":"29","key":"xgmxwwdIaO"}],"key":"vf7r