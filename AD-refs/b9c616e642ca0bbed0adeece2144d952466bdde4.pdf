        <ul class="c-article-subject-list">
            <li class="c-article-subject-list__subject"><a href="/subjects/ageing" data-track="click" data-track-action="view subject" data-track-label="link">Ageing</a></li><li class="c-article-subject-list__subject"><a href="/subjects/biochemistry" data-track="click" data-track-action="view subject" data-track-label="link">Biochemistry</a></li><li class="c-article-subject-list__subject"><a href="/subjects/systems-biology" data-track="click" data-track-action="view subject" data-track-label="link">Systems biology</a></li>
